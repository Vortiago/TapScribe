.tapscribe-install.json

# Frontend typecheck tooling (devDep only, never shipped)
frontend/node_modules/
frontend/package-lock.json

# Perf soak reports (tests/e2e/test_next_perf_soak.py) — local measurements
perf-reports/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Operator-editable summarizer default (PUT /api/summarize/config) — runtime
# state like recordings/, never committed. (The empty prompt/hotwords text
# files ARE tracked as starter files; this one is created on first save.)
config/summarizer.json
