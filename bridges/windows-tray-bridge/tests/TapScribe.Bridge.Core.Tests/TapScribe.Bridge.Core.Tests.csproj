<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform: references the core ONLY (never the Windows project or
       NAudio), so it builds and runs on the ubuntu CI job too. The in-process
       /tap WebSocket server in TapClientWebSocketTests uses Kestrel, hence the
       ASP.NET Core framework reference (works on Linux and Windows; no admin,
       unlike HttpListener). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
  </ItemGroup>

  <!-- The Windows WinForms E2E project reuses the in-process FakeRecorderServer test double.
       This project itself stays cross-platform (built directly by the ubuntu core job); the
       consumer is net10.0-windows and only built by the windows .slnx job. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TapScribe.TrayBridge.Tests" />
  </ItemGroup>

</Project>
