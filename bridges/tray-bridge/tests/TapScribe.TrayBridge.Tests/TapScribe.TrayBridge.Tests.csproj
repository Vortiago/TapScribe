<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only tests for the WinForms tray shell itself (TrayContext): the meeting
       lifecycle decisions — ownership, publish ordering, teardown, cancellation — that
       cannot be moved into the cross-platform core because they ARE the shell. Mirrors
       TapScribe.Bridge.Windows.Tests: net10.0-windows, so it builds and runs under the
       windows `dotnet-build` CI job, which names this csproj as one of its steps, and is
       never seen by the ubuntu core-only job, which targets the core test csproj directly.

       UseWindowsForms is the one addition over the sibling project: the subject under test
       is a WinForms ApplicationContext, so the tests reference ContextMenuStrip and
       ToolStripMenuItem directly. Those are plain components — nothing here registers a
       notification-area icon, creates a native timer window, shows a window, or enters a
       message loop, because the first run of this assembly on windows-latest crashed the
       test host before a single result doing exactly the first of those. WinForms types are
       STA-affine and xunit v2 runs MTA, so every test drives the shell through StaShell (a
       dedicated STA thread with a hand-pumped SynchronizationContext). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- xUnit1031 ("don't block on tasks in a test method") guards against deadlocking a
         test thread that owns a SynchronizationContext the awaited work needs. Neither half
         applies here and both are load-bearing the other way: these tests MUST be
         synchronous, because they drive an STA thread that is not the test's, and they block
         on the shell's fire-and-forget tasks precisely because the shell hands them to
         nobody. The xunit thread has no SynchronizationContext, the shell's continuations
         all run on the thread pool (ConfigureAwait(false) throughout), and every wait here
         is bounded, so a hang fails the test rather than the job. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TapScribe.TrayBridge\TapScribe.TrayBridge.csproj" />
  </ItemGroup>

</Project>
