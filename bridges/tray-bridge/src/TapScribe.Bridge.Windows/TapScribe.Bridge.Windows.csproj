<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only capture backend. The cross-platform core
       (TapScribe.Bridge.Core) deliberately does NOT reference this project
       or NAudio: capture sits behind IAudioCapture, WASAPI is one impl. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
  </ItemGroup>

</Project>
