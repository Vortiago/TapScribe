<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only capture backend. The cross-platform core
       (TapScribe.Bridge.Core) deliberately does NOT reference this project
       or NAudio: capture sits behind IAudioCapture, WASAPI is one impl. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compile (not run) the Windows-targeted projects on a non-Windows dev box,
         so a macOS contributor still has a compile gate for this side. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
  </ItemGroup>

</Project>
