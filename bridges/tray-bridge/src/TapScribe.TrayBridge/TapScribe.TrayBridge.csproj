<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal tray shell (PRD #99 user stories 1-11 land the real UX here).
       For the #103 tracer bullet it is just: NotifyIcon + Start/Stop/Quit,
       wiring WASAPI mic -> core Resampler/FrameChunker -> TapClient. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TapScribe.TrayBridge</RootNamespace>
    <!-- Compile (not run) the WinForms shell on a non-Windows dev box, so a macOS
         contributor still has a compile gate for this side. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
    <ProjectReference Include="..\TapScribe.Bridge.Windows\TapScribe.Bridge.Windows.csproj" />
  </ItemGroup>

  <!-- TrayContext is internal (it is the app's own shell, not an API), and its meeting
       lifecycle is exactly what the tray tests drive. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TapScribe.TrayBridge.Tests" />
  </ItemGroup>

  <!-- System.Security.Cryptography.ProtectedData (DPAPI, used by
       BridgeSettings to protect the tap token at rest) ships in the
       net10.0-windows framework, so no PackageReference is needed (NU1510). -->

</Project>
