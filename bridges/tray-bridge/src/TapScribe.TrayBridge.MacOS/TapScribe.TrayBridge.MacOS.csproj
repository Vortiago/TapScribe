<Project Sdk="Microsoft.NET.Sdk">

  <!-- The macOS menu-bar shell, the Mac sibling of TapScribe.TrayBridge. It holds no
       meeting logic: everything but the UI and the platform calls lives in
       TapScribe.Bridge.Core / TapScribe.Bridge.MacOS (ADR-0020). The UI itself lands in a
       later slice of #419; today this is the bundle, its Info.plist and the version floor.

       An Exe on this TFM is an app bundle. osx-arm64 and self-contained are ADR-0020's
       packaging decision (arm64-only, a zipped .app that needs no installed runtime).

       Building this project needs the macOS SDK that matches the installed macos workload
       (Xcode 26.4 or newer for workload 26.4). That is a hard requirement, not a nicety,
       because SupportedOSPlatformVersion below targets a deployment version OLDER than the
       SDK: the build then has to know which symbols existed in 14.4, which it can only read
       from the matching SDK's headers, and an older Xcode fails with MM0179. There is no
       build setting that buys a working bundle without it. The platform library and its
       tests do not target an older deployment version and build on any Xcode.

       ValidateXcodeVersion is off UNCONDITIONALLY rather than per CI job for a separate
       reason: its check is exact major.minor equality against the installed Xcode, not a
       floor, so it rejects a NEWER Xcode too and would break on every runner-image bump. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TapScribe.TrayBridge.MacOS</RootNamespace>

    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- The floor, and NOT a duplicate of the Info.plist entry beside it: the SDK stamps
         LSMinimumSystemVersion into the built bundle from this property, overwriting the
         source plist. Unset, it stamps the workload's own newest macOS and the .app opens
         on nothing. A test pins the two together. -->
    <SupportedOSPlatformVersion>14.4</SupportedOSPlatformVersion>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
    <ProjectReference Include="..\TapScribe.Bridge.MacOS\TapScribe.Bridge.MacOS.csproj" />
  </ItemGroup>

</Project>
