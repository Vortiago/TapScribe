<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS-only platform layer, the sibling of TapScribe.Bridge.Windows: the
       cross-platform core (TapScribe.Bridge.Core) references neither, so a Mac
       API can only ever enter through here. A plain net10.0-macos LIBRARY needs
       none of the app-bundle properties the test project carries; only an Exe
       switches that pipeline on. -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- LibraryImport is the source-generated P/Invoke shape, and the marshalling stubs it
         emits use pointers, so the generator refuses to run without this (SYSLIB1062). No
         hand-written unsafe code lives here. P/Invoke rather than the managed ObjC
         bindings because the bindings cannot be exercised under `dotnet test`; see
         MacOSProductVersion. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
  </ItemGroup>

  <!-- The version-string parse is internal (the shell only ever asks for the ambient
       reading), and it is exactly what the tests drive. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TapScribe.Bridge.MacOS.Tests" />
  </ItemGroup>

</Project>
