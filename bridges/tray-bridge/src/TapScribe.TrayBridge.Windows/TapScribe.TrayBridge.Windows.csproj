<Project Sdk="Microsoft.NET.Sdk">

  <!-- Minimal tray shell (PRD #99 user stories 1-11 land the real UX here).
       For the #103 tracer bullet it is just: NotifyIcon + Start/Stop/Quit,
       wiring WASAPI mic -> core Resampler/FrameChunker -> TapClient. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TapScribe.TrayBridge.Windows</RootNamespace>
    <!-- The project says which shell it is; the EXE keeps the name operators already have.
         It is what the release zip contains and what ADR-0012's artifact contract is named
         after, so renaming the project must not move it. -->
    <AssemblyName>TapScribe.TrayBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bridge.Core\TapScribe.Bridge.Core.csproj" />
    <ProjectReference Include="..\TapScribe.Bridge.Windows\TapScribe.Bridge.Windows.csproj" />
    <!-- The HOST ROLE (ADR-0022). One tray per OS carries both roles, and the SHELL is
         where they meet: neither core references the other, so a Bundle stays not-a-Bridge
         and a bridge-only install just never builds a TrayHost. Across trees on purpose —
         the Bundle assemblies are packaging, not bridges. -->
    <ProjectReference Include="..\..\..\..\packaging\bundle\src\TapScribe.Bundle.Core\TapScribe.Bundle.Core.csproj" />
    <ProjectReference Include="..\..\..\..\packaging\bundle\src\TapScribe.Bundle.Windows\TapScribe.Bundle.Windows.csproj" />
  </ItemGroup>

  <!-- TrayContext is internal (it is the app's own shell, not an API), and its meeting
       lifecycle is exactly what the tray tests drive. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TapScribe.TrayBridge.Windows.Tests" />
  </ItemGroup>

  <!-- System.Security.Cryptography.ProtectedData (DPAPI, used by
       DpapiTapTokenStore to protect the tap token at rest) ships in the
       net10.0-windows framework, so no PackageReference is needed (NU1510). -->

</Project>
