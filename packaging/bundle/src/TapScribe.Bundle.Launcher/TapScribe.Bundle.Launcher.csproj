<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray Launcher shell (ADR-0015). Deliberately THIN: everything that
       can be decided without a Windows API lives in TapScribe.Bundle.Core and
       is tested on Linux. What is left here can only run on windows-latest —
       the Job Object P/Invoke, NotifyIcon, the clipboard, and the actual
       process spawn — and is therefore not unit-tested at all. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TapScribe.Bundle.Launcher</RootNamespace>
    <AssemblyName>TapScribe</AssemblyName>
    <!-- The Job Object wrapper is the only unmanaged surface, and it uses classic
         DllImport so unsafe code stays off for the whole project (the
         source-generated LibraryImport stubs would require AllowUnsafeBlocks). -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapScribe.Bundle.Core\TapScribe.Bundle.Core.csproj" />
    <ProjectReference Include="..\TapScribe.Bundle.Windows\TapScribe.Bundle.Windows.csproj" />
  </ItemGroup>

</Project>
