<Project>

  <!-- Compile (not run) the Windows-targeted project on a non-Windows dev box, so a
       change to the shared Core has a compile gate for that side before CI sees it.
       A copy of bridges/tray-bridge/Directory.Build.targets, for the same reason and
       with the same caveat: MSBuild walks up from the project directory, so nothing
       under packaging/ inherits the tray tree's.

       In .targets rather than in Directory.Build.props: props is imported above the
       project body, where $(TargetFramework) is still empty, so the condition could
       not be written there. Targets is imported below it, which is still well before
       the framework-reference resolution that raises NETSDK1100. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
